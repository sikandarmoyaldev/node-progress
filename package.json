{
    "name": "@sikandarmoyaldev/progress",
    "version": "0.1.0",
    "description": "A lightweight, terminal-friendly progress bar for Node.js CLI tools",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "prepare": "husky",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:ui": "vitest --ui",
        "test:changed": "vitest run --changed",
        "test:grep": "vitest run -t",
        "type-check": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
        "build": "tsup src/index.ts --format esm,cjs --dts --clean"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "prettier --write",
            "eslint --fix",
            "vitest run --related"
        ],
        "*.{json,md}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@types/node": "^20.19.41",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "@vitest/coverage-v8": "^1.6.1",
        "@vitest/ui": "^1.6.1",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "husky": "^9.0.11",
        "lint-staged": "^17.0.7",
        "prettier": "^3.2.5",
        "tsup": "^8.0.2",
        "typescript": "^5.3.3",
        "vitest": "^1.3.1"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sikandarmoyaldev/node-progress.git"
    },
    "keywords": [
        "progress",
        "progressbar",
        "cli",
        "terminal",
        "nodejs",
        "typescript"
    ],
    "author": "Sikandar Moyal",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/sikandarmoyaldev/node-progress/issues"
    },
    "homepage": "https://github.com/sikandarmoyaldev/node-progress#readme"
}
