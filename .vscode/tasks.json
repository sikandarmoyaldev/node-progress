{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "pnpm: install",
            "type": "shell",
            "command": "pnpm",
            "args": ["install"],
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "pnpm: build",
            "type": "shell",
            "command": "pnpm",
            "args": ["build"],
            "problemMatcher": ["$tsc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "pnpm: test",
            "type": "shell",
            "command": "pnpm",
            "args": ["test"],
            "problemMatcher": [],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "pnpm: lint",
            "type": "shell",
            "command": "pnpm",
            "args": ["lint"],
            "problemMatcher": ["$eslint-stylish"],
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "pnpm: format",
            "type": "shell",
            "command": "pnpm",
            "args": ["format"],
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "pnpm: type-check",
            "type": "shell",
            "command": "pnpm",
            "args": ["type-check"],
            "problemMatcher": ["$tsc"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "pnpm: dev (watch)",
            "type": "shell",
            "command": "pnpm",
            "args": ["dev"],
            "problemMatcher": ["$tsc-watch"],
            "isBackground": true,
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
